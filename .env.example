# ─────────────────────────────────────────────────────────────────────────────
# LeadStream — environment template
#
# Copy this file to `.env.local` (gitignored) and fill in REAL values there.
# DO NOT commit real keys to this file — it is tracked by git.
#
# After you change any secret here in production, rotate it in the provider's
# dashboard and update Vercel → Settings → Environment Variables, then redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Find these at: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Bypasses RLS — never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# ── Telegram bot (optional) ─────────────────────────────────────────────────
# Create a bot via @BotFather, then:
#   - put the TOKEN here (server-only, NEVER prefix with NEXT_PUBLIC_)
#   - put the bot's @username (without "@") in NEXT_PUBLIC_TELEGRAM_BOT_USERNAME
#     so the frontend can build "Open in Telegram" links.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=comforttimeleadstream_bot

# ── Email (Resend) ──────────────────────────────────────────────────────────
# 1. Create account at https://resend.com (free tier: 3000 emails/month)
# 2. https://resend.com/api-keys → "Create API Key" (Full access) → copy
# 3. Domain options:
#    A) For testing only — leave RESEND_FROM as default "onboarding@resend.dev".
#       Resend allows sending only to YOUR OWN account email until you verify
#       a domain.
#    B) For production — https://resend.com/domains → "Add Domain", add the
#       SPF / DKIM / DMARC TXT records to your DNS, wait for "Verified",
#       then set RESEND_FROM="Brand <noreply@yourdomain>".
RESEND_API_KEY=
RESEND_FROM="Comfort Time <noreply@example.com>"
EMAIL_BRAND_NAME="Comfort Time"

# ── Bot defence (Cloudflare Turnstile) ──────────────────────────────────────
# 1. https://dash.cloudflare.com → Turnstile → "Add site"
#    - Domain: your-production-domain (add localhost for dev)
#    - Widget mode: Managed
# 2. Copy "Site key"   → NEXT_PUBLIC_TURNSTILE_SITE_KEY
# 3. Copy "Secret key" → TURNSTILE_SECRET_KEY (server-only)
# When unset, the order form falls back to honeypot + rate-limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
